# Privy declares `permissionless` as an optional peer, which pins an older `ox`
# than viem 2.55 uses. We never load smart wallets, so the conflict is over code
# that is never reached — but npm refuses the install without this flag, and
# Vercel runs a plain `npm install` with no chance to pass it by hand.
#
# The dependencies npm then silently skips (@stripe/crypto, @stripe/stripe-js)
# are pinned explicitly in package.json for exactly that reason.
legacy-peer-deps=true
